# === PostgreSQL ===
DATABASE_URL="postgresql://grades:grades_dev@localhost:5432/grades?schema=public"

# === NextAuth ===
NEXTAUTH_URL="http://localhost:3000"
# Сгенерировать: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-real-secret"

# Режим авторизации: 'dev' (Credentials provider без пароля) или 'keycloak'.
# Если пусто — 'dev' в development, 'keycloak' в production.
AUTH_MODE="dev"

# === Keycloak (нужно только при AUTH_MODE=keycloak) ===
KEYCLOAK_ISSUER=""
KEYCLOAK_CLIENT_ID=""
KEYCLOAK_CLIENT_SECRET=""

# === Импорт ===
# Путь к Excel-шаблону для скрипта импорта матрицы.
EXCEL_TEMPLATE_PATH="../Шаблон Скиллсет 2.0.xlsx"
