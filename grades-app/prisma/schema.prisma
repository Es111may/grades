// Грейды — Prisma schema
// Источник правды: 02_PRD.md §5
// Принципы:
//   - Матрица (Skill, Weight, MasteryLevel, GradeLevel, SkillGate) версионируется через MatrixVersion
//   - SkillTaxonomy и SkillGroup — глобальные (стабильные структурные элементы)
//   - Skill.active = true/false (мягкое выключение); удаление — только из архива через каскад
//   - Snapshot оценки замораживается в Assessment.snapshot — старые портреты не "съезжают" при правке матрицы
//   - User.gradeFloor — зафиксированный грейд при переходе со старой системы

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// MATRIX VERSIONING
// ============================================================

model MatrixVersion {
  id        Int      @id @default(autoincrement())
  number    Int      @unique
  comment   String?
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  createdBy Int?
  creator   User?    @relation("MatrixCreatedBy", fields: [createdBy], references: [id])

  skills      Skill[]
  weights     SkillWeight[]
  masteries   MasteryLevel[]
  grades      GradeLevel[]
  gates       SkillGate[]
  assessments Assessment[]

  @@map("matrix_versions")
}

// ============================================================
// REFERENCE DATA (global, not versioned)
// ============================================================

model Build {
  id          Int     @id @default(autoincrement())
  code        String  @unique // "creator" | "visioner" | "navigator"
  name        String
  description String?
  sortOrder   Int     @default(0)

  weights   SkillWeight[]
  gates     SkillGate[]
  designers User[]

  @@map("builds")
}

model SkillTaxonomy {
  id        Int    @id @default(autoincrement())
  code      String @unique // UI / UX / PRD / IND / RES
  name      String
  sortOrder Int    @default(0)

  groups SkillGroup[]

  @@map("skill_taxonomies")
}

model SkillGroup {
  id         Int    @id @default(autoincrement())
  taxonomyId Int
  taxonomy   SkillTaxonomy @relation(fields: [taxonomyId], references: [id])
  name       String
  sortOrder  Int    @default(0)

  skills Skill[]

  @@unique([taxonomyId, name])
  @@map("skill_groups")
}

// ============================================================
// SKILLS (versioned, with active flag)
// ============================================================

model Skill {
  id              Int     @id @default(autoincrement())
  matrixVersionId Int
  matrixVersion   MatrixVersion @relation(fields: [matrixVersionId], references: [id], onDelete: Cascade)
  groupId         Int
  group           SkillGroup    @relation(fields: [groupId], references: [id])

  name            String
  description     String  // italic-описание
  type            String  // "CORE" | "SEC"
  maxMasteryLevel Int     // 1..5
  replaceableNote String? // "Заменяемые навыки (З) — ..."
  rationale       String? // обоснование весов

  // Soft-toggle архивирования (см. PRD §6.5)
  active     Boolean   @default(true)
  archivedAt DateTime?

  weights   SkillWeight[]
  masteries MasteryLevel[]
  gates     SkillGate[]
  scores    AssessmentScore[]

  @@unique([matrixVersionId, groupId, name])
  @@index([matrixVersionId, active])
  @@map("skills")
}

model SkillWeight {
  id              Int   @id @default(autoincrement())
  matrixVersionId Int
  matrixVersion   MatrixVersion @relation(fields: [matrixVersionId], references: [id], onDelete: Cascade)
  skillId         Int
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  buildId         Int
  build           Build         @relation(fields: [buildId], references: [id])
  weight          Float

  @@unique([matrixVersionId, skillId, buildId])
  @@map("skill_weights")
}

model MasteryLevel {
  id              Int    @id @default(autoincrement())
  matrixVersionId Int
  matrixVersion   MatrixVersion @relation(fields: [matrixVersionId], references: [id], onDelete: Cascade)
  skillId         Int
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level           Int    // 1..N
  title           String // "Сервисный дизайн (З)"
  criteria        String // полный текст критерия

  @@unique([matrixVersionId, skillId, level])
  @@map("mastery_levels")
}

// ============================================================
// GRADES & GATES (versioned)
// ============================================================

model GradeLevel {
  id              Int    @id @default(autoincrement())
  matrixVersionId Int
  matrixVersion   MatrixVersion @relation(fields: [matrixVersionId], references: [id], onDelete: Cascade)
  code            String // "intern" | "junior" | "junior_plus" | "middle" | "middle_plus" | "senior"
  name            String
  sortOrder       Int
  // Порог XP может различаться между билдами; jsonb { "creator": 230, "visioner": 230, "navigator": 230 }
  xpThresholds    Json

  gates SkillGate[]

  @@unique([matrixVersionId, code])
  @@map("grade_levels")
}

model SkillGate {
  id              Int @id @default(autoincrement())
  matrixVersionId Int
  matrixVersion   MatrixVersion @relation(fields: [matrixVersionId], references: [id], onDelete: Cascade)
  gradeLevelId    Int
  gradeLevel      GradeLevel    @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  buildId         Int
  build           Build         @relation(fields: [buildId], references: [id])
  skillId         Int
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  requiredMastery Int

  @@unique([matrixVersionId, gradeLevelId, buildId, skillId])
  @@map("skill_gates")
}

// ============================================================
// USERS
// ============================================================

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  fullName     String
  ssoId        String? @unique
  passwordHash String? // bcrypt hash; null = пароль ещё не задан админом
  role         String  // "admin" | "lead" | "stardiz" | "designer"
  // Аватар — data URL (data:image/jpeg;base64,...). Ресайзим на клиенте до 256×256.
  avatarUrl    String? @db.Text

  buildId    Int?
  build      Build?    @relation(fields: [buildId], references: [id])
  department String?
  leadId     Int?
  lead       User?     @relation("LeadDesigners", fields: [leadId], references: [id])
  designers  User[]    @relation("LeadDesigners")
  // Опциональный второй наставник: stardiz = senior-дизайнер с правами лида, но он сам грейдируется
  stardizId          Int?
  stardiz            User?  @relation("StardizDesigners", fields: [stardizId], references: [id])
  designersAsStardiz User[] @relation("StardizDesigners")
  hiredAt    DateTime?
  active     Boolean   @default(true)

  // Grade floor (см. PRD §6.3)
  gradeFloor       String? // grade code or null
  gradeFloorReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Связи
  matricesCreated      MatrixVersion[]    @relation("MatrixCreatedBy")
  notesAboutMe         DesignerNote[]     @relation("NoteDesigner")
  notesIWrote          DesignerNote[]     @relation("NoteAuthor")
  assessmentsAsDesigner Assessment[]      @relation("DesignerAssessments")
  assessmentsAsLead    Assessment[]       @relation("LeadAssessments")
  auditEntries         AuditLog[]
  matrixCell           TeamMatrixCell?    @relation("UserMatrixCell")
  matrixCellsUpdated   TeamMatrixCell[]   @relation("MatrixCellUpdater")
  leadReviewsAboutMe   LeadReview[]       @relation("LeadReviewTarget")
  leadReviewsIImported LeadReview[]       @relation("LeadReviewCreator")

  @@map("users")
}

// ============================================================
// EXCLUDED EMAILS (защита от автоматического воссоздания)
// Когда админ hard-удаляет пользователя, его email сюда записывается,
// чтобы scripts/import-team.ts при следующем деплое не вернул его из CSV.
// ============================================================

model ExcludedEmail {
  email      String   @id
  excludedAt DateTime @default(now())
  reason     String?

  @@map("excluded_emails")
}

// ============================================================
// 9-BOX TEAM MATRIX (Phase 9, см. PRD §11.1)
// Каждый дизайнер/стардиз размещается в одной из 9 ячеек.
// Отсутствие записи = пользователь в зоне «Не размещены».
// ============================================================

model TeamMatrixCell {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  user             User     @relation("UserMatrixCell", fields: [userId], references: [id], onDelete: Cascade)
  potentialLevel   String   // "low" | "mid" | "high"
  performanceLevel String   // "low" | "mid" | "high"
  updatedAt        DateTime @updatedAt
  updatedById      Int
  updatedBy        User     @relation("MatrixCellUpdater", fields: [updatedById], references: [id])

  @@map("team_matrix_cells")
}

model DesignerNote {
  id         Int      @id @default(autoincrement())
  designerId Int
  designer   User     @relation("NoteDesigner", fields: [designerId], references: [id], onDelete: Cascade)
  authorId   Int
  author     User     @relation("NoteAuthor", fields: [authorId], references: [id])
  text       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([designerId])
  @@map("designer_notes")
}

// ============================================================
// ASSESSMENTS
// ============================================================

model Assessment {
  id              Int       @id @default(autoincrement())
  designerId      Int
  designer        User      @relation("DesignerAssessments", fields: [designerId], references: [id])
  leadId          Int
  lead            User      @relation("LeadAssessments", fields: [leadId], references: [id])
  matrixVersionId Int
  matrixVersion   MatrixVersion @relation(fields: [matrixVersionId], references: [id])

  cycle           String    // "2026-04" | "2026-10"
  status          String    // "draft" | "published" | "archived"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  publishedAt     DateTime?

  // Кэш расчёта (для быстрых выборок)
  totalXp         Float?
  calculatedGrade String?
  effectiveGrade  String?
  // Полный snapshot — гарантия, что портрет не "съедет" при правке матрицы
  snapshot        Json?
  // Мнение лида/стардиза, написанное на форме оценки (markdown).
  // Показывается на портрете дизайнера — аналог CDO-блока у лидов.
  leadComment     String?       @db.Text

  scores  AssessmentScore[]
  history AssessmentHistory[]

  @@index([designerId, cycle])
  @@index([leadId, status])
  @@map("assessments")
}

model AssessmentScore {
  id           Int      @id @default(autoincrement())
  assessmentId Int
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  skillId      Int
  skill        Skill      @relation(fields: [skillId], references: [id])
  masteryLevel Int        // 0..N (0 = не оценено)
  comment      String?    @db.Text
  evidenceUrl  String?
  // Пометка «вернуться к навыку» — флажок, который лид ставит в режиме
  // черновика, чтобы не забыть пересмотреть навык до публикации.
  flagged      Boolean    @default(false)
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, skillId])
  @@map("assessment_scores")
}

model AssessmentHistory {
  id           Int      @id @default(autoincrement())
  assessmentId Int
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  changedById  Int
  changedAt    DateTime @default(now())
  action       String   // "create" | "update_score" | "publish" | "edit"
  diff         Json

  @@index([assessmentId, changedAt])
  @@map("assessment_history")
}

// ============================================================
// AUDIT LOG (общий — для чувствительных действий)
// ============================================================

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int
  actor      User     @relation(fields: [actorId], references: [id])
  action     String   // "matrix_version_created" | "grade_floor_changed" | "skill_deactivated" | "skill_deleted" | "grade_floor_lowered" | ...
  targetType String   // "user" | "skill" | "matrix" | "assessment"
  targetId   Int?
  details    Json     // { before: ..., after: ..., reason: "..." }
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_log")
}

// ============================================================
// LEAD REVIEW (Phase 22, см. PRD §11.14)
// 360-оценка лида/стардиза из анонимного Google Form-опроса.
// Админ грузит CSV-экспорт → парсер считает агрегаты → сохраняем.
// Поля aiSummary и cdoSummary — markdown, заполняет админ вручную.
// Видимость самому лиду — сразу с момента создания (без публикации).
// ============================================================

model LeadReview {
  id            Int      @id @default(autoincrement())
  targetUserId  Int
  targetUser    User     @relation("LeadReviewTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  // Свободный текст: "Q2 2026", "Май 2026", "Декабрь 2025"
  period        String
  // Версия шаблона опроса. Растёт при изменении набора вопросов.
  // На v1 захардкожен в src/lib/leadSurvey.ts (6 категорий + eNPS + 4 открытых).
  surveyVersion Int      @default(1)
  // Сколько строк-ответов получили (для перепарса при необходимости).
  responseCount Int      @default(0)
  // Сырой CSV — на случай если поменяется логика парсинга.
  rawCsv        String   @db.Text
  // Готовые агрегаты для отрисовки портрета. Структура — см. parseLeadReviewCsv.
  aggregates    Json
  // Сводка ИИ-выводов. Markdown, заполняется админом вручную (Pavel прогоняет
  // через ChatGPT/Gemini снаружи и вставляет результат).
  aiSummary     String?  @db.Text
  // CDO-блок: KPI периода, наблюдения, итоговая оценка от Pavel'a. Markdown.
  cdoSummary    String?  @db.Text

  createdById   Int
  createdBy     User     @relation("LeadReviewCreator", fields: [createdById], references: [id])
  importedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([targetUserId, importedAt])
  @@map("lead_reviews")
}
